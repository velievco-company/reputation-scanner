# Пример файла секретов.
# На Streamlit Community Cloud: Settings -> Secrets -> вставить содержимое (без .example в названии)
# Локально: скопировать этот файл в .streamlit/secrets.toml (без .example) и вставить свои ключи

# Groq API — https://console.groq.com (бесплатно, email/Google регистрация)
GROQ_API_KEY = ""

# Bright Data SERP API — https://brightdata.com (ОСНОВНОЙ источник поиска, уже подключен)
# Zone: serp_api. Стабильнее DuckDuckGo на облачных IP Streamlit Cloud.
BRIGHTDATA_API_KEY = ""

# Brave Search API — https://api.search.brave.com/register (опционально, доп. резерв)
# Пока не задан — используется DuckDuckGo как резерв после Bright Data
BRAVE_API_KEY = ""

# NewsAPI.org — https://newsapi.org/register (опционально, 1000 req/день бесплатно)
# Даёт точные даты публикации новостей — используется параллельно с DuckDuckGo,
# не вместо него: DuckDuckGo покрывает форумы/блоги, NewsAPI — новостные издания
NEWSAPI_KEY = ""
